<?xml version="1.0" encoding="utf-8"?>
<!--
  Playback-speed sheet, touch-first (YouTube's current speed sheet; NewPipe's tempo/pitch dialog):
  the speed in large type, a slider (0.25x .. 4x in 0.05 steps) between -/+ buttons that nudge it
  by one step, and a row of preset pills for the common speeds; below, the same slider and
  buttons for pitch (50% .. 200%, shown while audio time-stretching is on), with a reset. Nothing
  to scroll to: every speed is one drag or one tap away. Changes apply as they are made and the
  sheet stays open. "More speeds" still opens the full TV speed dialog (remember-speed options).
  Filled in MobilePlaybackActivity.showSpeedSheet().

  NEWTUBE(sheet-landscape): handle, title and hairline stay put and only the body scrolls - held
  sideways, the player caps the sheet below the top edge.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_mobile_sheet"
    android:orientation="vertical"
    android:paddingBottom="12dp">

    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_mobile_sheet_handle" />

    <TextView
        android:id="@+id/speed_sheet_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="20dp"
        android:paddingTop="10dp"
        android:paddingBottom="12dp"
        android:text="@string/mobile_player_speed"
        android:textColor="@color/mobile_color_on_surface"
        android:textSize="16sp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/mobile_color_divider" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp">

            <TextView
                android:id="@+id/speed_sheet_value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:accessibilityLiveRegion="polite"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:textColor="@color/mobile_color_on_surface"
                android:textSize="32sp"
                tools:text="1.25x" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/speed_sheet_slower"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_mobile_speed_step"
                    android:contentDescription="@string/mobile_speed_slower"
                    android:src="@drawable/ic_mobile_remove" />

                <com.google.android.material.slider.Slider
                    android:id="@+id/speed_sheet_slider"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:contentDescription="@string/mobile_player_speed"
                    android:stepSize="0.05"
                    android:valueFrom="0.25"
                    android:valueTo="4.0"
                    app:haloColor="@color/mobile_color_divider"
                    app:labelBehavior="gone"
                    app:thumbColor="@color/mobile_color_on_surface"
                    app:tickVisible="false"
                    app:trackColorActive="@color/mobile_color_on_surface"
                    app:trackColorInactive="@color/mobile_color_divider" />

                <ImageButton
                    android:id="@+id/speed_sheet_faster"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_mobile_speed_step"
                    android:contentDescription="@string/mobile_speed_faster"
                    android:src="@drawable/ic_mobile_add" />

            </LinearLayout>

            <!-- Preset pills, one per SPEED_CHIPS entry (item_mobile_speed_chip). -->
            <LinearLayout
                android:id="@+id/speed_sheet_chips"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal" />

            <LinearLayout
                android:id="@+id/speed_sheet_pitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="vertical">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginHorizontal="-16dp"
                    android:background="@color/mobile_color_divider" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingStart="4dp"
                        android:paddingEnd="8dp"
                        android:text="@string/mobile_pitch"
                        android:textColor="@color/mobile_color_on_surface"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/speed_sheet_pitch_value"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:accessibilityLiveRegion="polite"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="@color/mobile_color_on_surface"
                        android:textSize="15sp"
                        tools:text="100%" />

                    <TextView
                        android:id="@+id/speed_sheet_pitch_reset"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:background="?attr/selectableItemBackground"
                        android:gravity="center"
                        android:paddingHorizontal="12dp"
                        android:text="@string/mobile_pitch_reset"
                        android:textColor="@color/mobile_color_on_surface"
                        android:textSize="14sp" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageButton
                        android:id="@+id/speed_sheet_pitch_lower"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_mobile_speed_step"
                        android:contentDescription="@string/mobile_pitch_lower"
                        android:src="@drawable/ic_mobile_remove" />

                    <com.google.android.material.slider.Slider
                        android:id="@+id/speed_sheet_pitch_slider"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:contentDescription="@string/mobile_pitch"
                        android:stepSize="5"
                        android:valueFrom="50"
                        android:valueTo="200"
                        app:haloColor="@color/mobile_color_divider"
                        app:labelBehavior="gone"
                        app:thumbColor="@color/mobile_color_on_surface"
                        app:tickVisible="false"
                        app:trackColorActive="@color/mobile_color_on_surface"
                        app:trackColorInactive="@color/mobile_color_divider" />

                    <ImageButton
                        android:id="@+id/speed_sheet_pitch_higher"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_mobile_speed_step"
                        android:contentDescription="@string/mobile_pitch_higher"
                        android:src="@drawable/ic_mobile_add" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="8dp"
        android:background="@color/mobile_color_divider" />

    <LinearLayout
        android:id="@+id/speed_sheet_more"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        android:paddingVertical="13dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/mobile_speed_more"
            android:textColor="@color/mobile_color_on_surface"
            android:textSize="15sp" />

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_chevron_right"
            android:tint="@color/mobile_color_on_surface_secondary" />

    </LinearLayout>

</LinearLayout>
